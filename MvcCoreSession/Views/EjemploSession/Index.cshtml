    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model List<Mascota>

<h1>Ejemplos Session</h1>

<h2 style="color:rebeccapurple">
    @Context.Session.GetString("nombre")
</h2>

<h2 style="color:rebeccapurple">
    @Context.Session.GetString("hora")
</h2>

@{
    Mascota mascota = Context.Session.GetObject<Mascota>("MASCOTAGENERICA");
    List<Mascota> lista = Context.Session.GetObject<List<Mascota>>("LISTAMASCOTAS");
}

@if(mascota != null)
{
    <h2 style="color:rebeccapurple">
        Mascota: @mascota.Nombre, @mascota.Raza, @mascota.Edad
    </h2>   
    
}

@if(lista != null)
{
    <table class="table table-info table-bordered">
        <thead>
            <tr>
                <th>NOMBRE</th>
                <th>RAZA</th>
                <th>EDAD</th>
            </tr>
        </thead>
        <tbody>
            @foreach(Mascota mascot in lista)
            {
                <tr>
                    <td>@mascot.Nombre</td>
                    <td>@mascot.Raza</td>
                    <td>@mascot.Edad</td>
                </tr>
            }
        </tbody>
    </table>
}


<ul class="list-group">
    <li class="list-group-item">
        <a asp-controller="EjemploSession" asp-action="SessionSimple">SessionSimple</a>
    </li>
    <li class="list-group-item">
        <a asp-controller="EjemploSession" asp-action="SessionMascotaBytes">Session mascota</a>
    </li>
    <li class="list-group-item">
        <a asp-controller="EjemploSession" asp-action="SessionMascotaCollectionBytes">Session List mascotas</a>
    </li>
    <li class="list-group-item">
        <a asp-controller="EjemploSession" asp-action="SessionMascotaJson">Mascota JSON</a>
    </li>
    <li class="list-group-item">
        <a asp-controller="EjemploSession" asp-action="SessionMascotaGenericos">Mascota Genericos</a>
    </li>
    <li class="list-group-item">
        <a asp-controller="EjemploSession" asp-action="SessionMascotasCollectionGeneric">Lista Mascotas Genericos</a>
    </li>
</ul>


@if(Model != null)
{
    <table class="table table-info table-bordered">
        <thead>
            <tr>
                <th>NOMBRE</th>
                <th>RAZA</th>
                <th>EDAD</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Mascota mascot in Model)
            {
                <tr>
                    <td>@mascot.Nombre</td>
                    <td>@mascot.Raza</td>
                    <td>@mascot.Edad</td>
                </tr>
            }
        </tbody>
    </table>

}